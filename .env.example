# Copy to .env and adjust:  copy .env.example .env
# See README.md and docs/speculative-decoding.md

CODER_MODEL=Qwen3.6-27B-MTP-UD-Q4_K_XL.gguf
LLAMA_MODEL=Qwen3.6-27B-MTP-UD-Q4_K_XL.gguf
VISION_MODEL=Qwen3.6-27B-MTP-UD-Q4_K_XL.gguf

MAX_LOADED_MODELS=1
CODER_PORT=8765
LLAMA_PORT=8766
VISION_PORT=8767
WEBUI_PORT=8080

OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:8765/v1
OLLAMA_PORT=11434
INFERENCE_BACKEND=llamacpp
LLAMA_BACKEND=llamacpp

AIDEN_USE_RESOURCE_LIMITS=1
AIDEN_LLM_MEM_LIMIT=44g
AIDEN_ROUTER_MEM_LIMIT=512m
AIDEN_MCP_MEM_LIMIT=768m
AIDEN_WEBUI_MEM_LIMIT=4g

PROMPT_PIPELINE=claw,caveman
AUTO_LAUNCH_CLAW=true
WEBUI_AUTH=false

OLLAMA_FLASH_ATTENTION=1
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_THREADS=0
OLLAMA_MAX_VRAM=3758096384
OLLAMA_NUM_PARALLEL=1

LLAMACPP_PORT=8081
LLAMACPP_GGUF=Qwen3.6-27B-MTP-UD-Q4_K_XL.gguf
LLAMACPP_IMAGE=havenoammo/llama:cuda12-server
LLAMACPP_SPEC_MODE=mtp
LLAMACPP_DRAFT_NGL=-1
LLAMACPP_CTX_SIZE=16384
AIDEN_CTX_RESERVE=3072
AIDEN_MAX_MSG_CHARS=12000
LLAMACPP_THREADS=8
LLAMACPP_SPEC_DRAFT_N_MAX=3

OLLAMA_MCP_TEMPERATURE=0.15
OLLAMA_MCP_TOP_P=0.9
OLLAMA_MCP_MAX_TOKENS=2048
OLLAMA_MCP_TOOL_RETRY=1
OLLAMA_MCP_WORKSPACE=/workspace
OLLAMA_MCP_AGENT_MAX_STEPS=8
OLLAMA_MCP_CMD_TIMEOUT=120

JUPYTER_PASSWORD=changeme
ANTHROPIC_AUTH_TOKEN=bullshittoken 
ANTHROPIC_API_KEY=bullshitkey
